# --- environment ---
AIRLOCK_ENV=dev                              # dev | staging | prod (prod refuses dev defaults)
# --- models (Vultr Serverless Inference) ---
AIRLOCK_LLM_PROVIDER=dummy                   # dummy | vultr
AIRLOCK_VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
AIRLOCK_VULTR_INFERENCE_API_KEY=
AIRLOCK_PLANNER_MODEL=                       # pick from GET /v1/models at kickoff (catalog rotates; IDs are lowercase slugs)
AIRLOCK_CODER_MODEL=
AIRLOCK_LLM_TOKEN_BUDGET_PER_RUN=120000
# --- sandbox ---
AIRLOCK_SANDBOX_BACKEND=dummy                # dummy | docker | vultr_vm
AIRLOCK_SANDBOX_RUNTIME=runsc                # runsc (gVisor) | runc (weaker, label in UI)
AIRLOCK_SANDBOX_MEM_LIMIT=1g
AIRLOCK_SANDBOX_CPUS=1.0
AIRLOCK_SANDBOX_PIDS_LIMIT=128
AIRLOCK_SANDBOX_INSTALL_TIMEOUT_S=180        # install phase (dependency installs are slow)
AIRLOCK_SANDBOX_TEST_TIMEOUT_S=120
AIRLOCK_EGRESS_PROXY=http://egress-proxy:3128
AIRLOCK_EGRESS_NETWORK=airlock-egress
# --- storage / queue ---
AIRLOCK_DATABASE_URL=sqlite+aiosqlite:///./airlock.db
AIRLOCK_DB_PATH=./airlock-store.db             # run store persistence ("" disables)
AIRLOCK_QUEUE_BACKEND=inprocess              # inprocess | arq
AIRLOCK_WORKER_CONCURRENCY=2
# --- auth / limits ---
AIRLOCK_SESSION_SECRET=                      # 32+ random bytes in prod
AIRLOCK_BOOTSTRAP_ADMIN_KEY=
AIRLOCK_RATE_LIMIT_RUNS_PER_MIN=5
AIRLOCK_RATE_LIMIT_DEMO_PER_MIN=10
# --- external ---
AIRLOCK_GITHUB_TOKEN=                        # read-only, public repos; lifts the 60 req/h limit
AIRLOCK_VULTR_API_KEY=                       # only for the VM-per-run stretch; IP-allow-listed
